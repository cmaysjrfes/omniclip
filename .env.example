# ---- Core ----
DATABASE_URL=postgresql+asyncpg://omni:omni@postgres:5432/omniclip
SYNC_DATABASE_URL=postgresql+psycopg2://omni:omni@postgres:5432/omniclip
PRISMA_DATABASE_URL=postgresql://omni:omni@postgres:5432/omniclip
REDIS_URL=redis://redis:6379/0
API_KEY=change-me-internal-team-key

# ---- Object storage (SeaweedFS S3 locally, AWS S3 in prod) ----
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333   # what the browser uses for uploads/playback
S3_BUCKET=omniclip
AWS_ACCESS_KEY_ID=omniclip                     # must match infra/seaweedfs-s3.json
AWS_SECRET_ACCESS_KEY=omniclip-dev-secret
AWS_REGION=us-east-1

# ---- AI ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_FAST_MODEL=claude-haiku-5-5
WHISPER_MODEL=small          # CPU default; the GPU override uses large-v3
WHISPER_DEVICE=cpu           # cuda | cpu
WHISPER_COMPUTE_TYPE=int8    # float16 on GPU, int8 on CPU

# ---- Rendering ----
FFMPEG_GPU=false             # the GPU override turns on h264_nvenc + cuda decode
RENDER_WIDTH=1080
RENDER_HEIGHT=1920

# ---- YouTube (Google Cloud OAuth "Web application" client) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/channels/oauth/callback
YOUTUBE_API_KEY=             # server key for public Data API reads (competitor analysis)
TOKEN_ENCRYPTION_KEY=        # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-internal-team-key
